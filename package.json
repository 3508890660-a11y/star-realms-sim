{
  "name": "star-realms-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Star Realms engine, scripted AI runner and spectator UI",
  "scripts": {
    "start": "node src/server/server.js",
    "play": "node src/cli.js play",
    "batch": "node src/cli.js batch",
    "swiss": "node src/tourney-cli.js",
    "swiss:team": "node src/team-tourney-cli.js",
    "lab": "node src/team-lab-cli.js",
    "lab:summary": "node src/team-lab-summary.js",
    "lab:recompute": "node src/team-lab-recompute.js",
    "mode:3v3": "node src/mode-tourney-cli.js",
    "mode:summary": "node src/mode-summary.js",
    "mode:3v3:clone": "node src/mode-lab-cli.js",
    "mode:3v3:clone-summary": "node src/mode-lab-summary.js",
    "test": "node --test test/*.test.js"
